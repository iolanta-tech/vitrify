# Generated by `j cli-model`. Do not edit.
"@context": "urn:vitrify:cli"
"@graph":
  - $id: "urn:vitrify:cli:sparql"
    $type: "cwl:CommandLineTool"
    name: sparql
    order: 1
    comment: Execute a SPARQL query and write the response to a file.
    inputs:
      - $id: "urn:vitrify:cli:sparql:endpoint"
        $type: "cwl:CommandInputParameter"
        name: endpoint
        usage: "--endpoint IRI"
        order: 1
        valueRequired: true
        comment: SPARQL endpoint URL.
        inputBinding:
          $type: "cwl:CommandLineBinding"
          prefix: "--endpoint"
      - $id: "urn:vitrify:cli:sparql:query"
        $type: "cwl:CommandInputParameter"
        name: query
        usage: "--query PATH"
        order: 2
        valueRequired: true
        comment: "Query file path, or `-` to read the query from standard input."
        inputBinding:
          $type: "cwl:CommandLineBinding"
          prefix: "--query"
      - $id: "urn:vitrify:cli:sparql:to"
        $type: "cwl:CommandInputParameter"
        name: to
        usage: "--to DIRECTORY"
        order: 3
        valueRequired: true
        comment: Output directory for the result and its RO-Crate.
        inputBinding:
          $type: "cwl:CommandLineBinding"
          prefix: "--to"
      - $id: "urn:vitrify:cli:sparql:format"
        $type: "cwl:CommandInputParameter"
        name: format
        usage: "--format FORMAT"
        order: 4
        valueRequired: false
        comment: Requested result format. Omit it to accept the endpoint choice.
        inputBinding:
          $type: "cwl:CommandLineBinding"
          prefix: "--format"
  - $id: "urn:vitrify:cli:context"
    $type: "cwl:CommandLineTool"
    name: context
    order: 2
    comment: Fetch a JSON-LD or YAML-LD context and print it with retrieval metadata.
    inputs:
      - $id: "urn:vitrify:cli:context:url"
        $type: "cwl:CommandInputParameter"
        name: url
        usage: URL
        order: 1
        valueRequired: true
        comment: Absolute HTTP(S) URL of the context.
      - $id: "urn:vitrify:cli:context:as"
        $type: "cwl:CommandInputParameter"
        name: as
        usage: "--as jsonld or --as yamlld"
        order: 2
        valueRequired: false
        comment: Serialization of the printed document. jsonld is the default.
        inputBinding:
          $type: "cwl:CommandLineBinding"
          prefix: "--as"
